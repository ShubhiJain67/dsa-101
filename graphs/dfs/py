class Solution:
    def dfs(self, adj):
        visited = []
        for i in range(len(adj)):
            visited.append(False)
        traversal = []
        for i in range(len(adj)):
            if not visited[i]:
                self._dfs(adj, i, visited, traversal)
        return traversal

    
    def _dfs(self, adj, start, visited, traversal):
        if visited[start]:
            return
        visited[start] = True
        traversal.append(start)
        for node in adj[start]:
            if not visited[node]:
                self._dfs(adj, node, visited, traversal)
        
